{
  "name": "rooms",
  "version": "0.1.18-rc.33",
  "private": true,
  "description": "A private desktop clubhouse",
  "author": "ROOMS",
  "license": "MIT",
  "main": "dist-electron/main.cjs",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "qa:shots": "node scripts/fixture-shots.mjs",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && vite build && node scripts/build-notices.mjs && node scripts/build-electron.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:desktop": "playwright test",
    "e2e:stack": "node tests/e2e/stack/stack.mjs",
    "e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "e2e:report": "playwright show-report .local/e2e/report",
    "start": "electron .",
    "package:mac": "node scripts/release-preflight.mjs && pnpm build && node scripts/prepare-remote-input.mjs && electron-builder --mac dmg zip --arm64 && node scripts/verify-mac-signature.mjs",
    "package:win": "pnpm build && node scripts/prepare-remote-input.mjs && electron-builder --win nsis --x64",
    "services:build": "node scripts/build-services.mjs",
    "livekit:native": "node scripts/livekit-native.mjs",
    "verify:media": "node scripts/livekit-verify.mjs",
    "activities:native": "node dist-services/activities.cjs",
    "agent:server": "node dist-services/agent.cjs",
    "stoat:setup": "node scripts/stoat-setup.mjs",
    "stoat:verify": "node scripts/stoat-integration.mjs",
    "package:mac:signed": "node scripts/package-signed-mac.mjs",
    "verify:activities": "node scripts/verify-activity-desktop.mjs",
    "release:mac": "node scripts/package-signed-mac.mjs",
    "lint": "eslint apps packages tests scripts *.ts *.mjs --max-warnings 0",
    "verify:ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm services:build",
    "release:mac:publish": "ROOMS_PUBLISH_UPDATES=1 node scripts/package-signed-mac.mjs",
    "format": "prettier --write apps packages tests tooling scripts *.json *.ts *.mjs .github",
    "format:check": "prettier --check apps packages tests tooling scripts *.json *.ts *.mjs .github",
    "prepare:vlc": "node scripts/prepare-vlc.mjs"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.0",
    "@remixicon/react": "4.9.0",
    "@sapphi-red/gtcrn-wasm": "0.0.3",
    "@sapphi-red/web-noise-suppressor": "0.4.1",
    "@tanstack/react-query": "5.104.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron-updater": "^6.8.9",
    "fastify": "5.12.5",
    "hls.js": "^1.7.3",
    "livekit-client": "2.22.3",
    "livekit-server-sdk": "2.19.1",
    "lucide-react": "1.52.0",
    "mongodb": "^7.7.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-aria": "3.53.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "tailwind-merge": "3.7.0",
    "tone": "15.1.22",
    "ws": "8.22.0",
    "zod": "4.6.6",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "5.2.0",
    "amqplib": "2.2.0",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "private.rooms.desktop",
    "productName": "ROOMS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/**/docs/**",
      "!node_modules/**/doc/**",
      "!node_modules/**/examples/**",
      "!node_modules/**/example/**"
    ],
    "mac": {
      "category": "public.app-category.social-networking",
      "target": [
        "dmg",
        "zip"
      ],
      "minimumSystemVersion": "14.0",
      "hardenedRuntime": false,
      "extendInfo": {
        "CFBundleDisplayName": "Tayfa",
        "NSMicrophoneUsageDescription": "Tayfa uses your microphone only when you start a microphone test or join a voice room.",
        "NSCameraUsageDescription": "Tayfa uses your camera only when you enable video.",
        "NSAudioCaptureUsageDescription": "Tayfa captures system audio only when you explicitly enable sound for a selected screen share."
      },
      "icon": "apps/desktop/public/icon.icns",
      "identity": "-",
      "entitlements": "infra/release/entitlements.mac.plist",
      "entitlementsInherit": "infra/release/entitlements.mac.plist"
    },
    "win": {
      "target": "nsis",
      "artifactName": "ROOMS-${version}-windows-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "protocols": [
      {
        "name": "Tayfa invitation links",
        "schemes": [
          "rooms"
        ]
      }
    ],
    "afterPack": "scripts/mac-preview-after-pack.cjs",
    "extraMetadata": {
      "roomsRemoteInput": true
    }
  }
}
